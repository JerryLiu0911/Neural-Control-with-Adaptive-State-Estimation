\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Empirical (black/grey) vs.\ identified-model (red/blue) principal gains (left) and relative reconstruction error (right). $\sigma _1$ is captured at low frequency; $\sigma _2$ is badly under-modelled and the error grows with frequency, where coherence collapses --- the regime the controller must avoid.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:frf}{{3}{4}{Empirical (black/grey) vs.\ identified-model (red/blue) principal gains (left) and relative reconstruction error (right). $\sigma _1$ is captured at low frequency; $\sigma _2$ is badly under-modelled and the error grows with frequency, where coherence collapses --- the regime the controller must avoid}{figure.caption.3}{}}
